<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.kodiakso" name="PZ8" version="1.7.0" provider-name="Luigi">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.28.0"/>
        <import addon="inputstream.adaptive" version="19.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">PZ8 - IPTV player</summary>
        <summary lang="it">PZ8 - Lettore IPTV</summary>
        <description lang="en">IPTV player with M3U playlist, Sky, DAZN and TMDB films & TV series.</description>
        <description lang="it">Lettore IPTV con playlist M3U, canali Sky, DAZN e sezione Film &amp; Serie TV da TMDB.</description>
        <platform>all</platform>
        <license>MIT</license>
        <source>https://github.com/luishighnest/kodi</source>
        <website>https://luishighnest.github.io/kodi/</website>
        <news>v1.7.0: nuovo logo addon senza scritte, menu configurazione organizzato in categorie. v1.6.7: icone reali per EVENTI e TV in home.
    </extension>
</addon>
<addon id="repository.luishighnest" name="Luigi Repo" version="1.0.0" provider-name="Luigi">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="Luigi Repo">
        <dir>
            <info compressed="false">https://luishighnest.github.io/kodi/addons.xml</info>
            <checksum verify="true">https://luishighnest.github.io/kodi/addons.xml.md5</checksum>
            <datadir zip="true">https://luishighnest.github.io/kodi/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">Luigi repository</summary>
        <summary lang="it">Repository di Luigi</summary>
        <description lang="en">Kodi repository hosting the Kodi Akso plugin.</description>
        <description lang="it">Repository Kodi che ospita il plugin Kodi Akso.</description>
        <platform>all</platform>
        <license>MIT</license>
        <source>https://github.com/luishighnest/kodi</source>
        <website>https://luishighnest.github.io/kodi/</website>
        <news>Initial release.</news>
    </extension>
</addon>
</addons>

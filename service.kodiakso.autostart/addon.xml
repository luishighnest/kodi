<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.kodiakso.autostart" name="PZ8 Autostart" version="1.0.1" provider-name="Luigi">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="it">Avvio automatico PZ8</summary>
        <summary lang="en">PZ8 auto-launch</summary>
        <description lang="it">All'apertura di Kodi apre in automatico l'addon PZ8 (plugin.video.kodiakso). Disattivabile dalle impostazioni.</description>
        <description lang="en">On Kodi startup it automatically opens the PZ8 addon (plugin.video.kodiakso). Can be disabled in settings.</description>
        <license>MIT</license>
        <source>https://github.com/luishighnest/kodi</source>
    </extension>
</addon>
